    "buy_now_button": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"fm-bn-src\" data-fm-bn-src hidden>\n  <button type=\"button\" class=\"fm-bn\" data-fm-buy-now {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>\n    <span data-fm-bn-label>Acheter maintenant</span>\n  </button>\n</div>\n<style>\n  .fm-bn { display:flex; align-items:center; justify-content:center; width:100%; min-height:52px; margin-top:10px; padding:14px 20px; background:#1A1A1A; color:#FFFFFF; border:0; border-radius:8px; font:inherit; font-size:16px; font-weight:700; letter-spacing:.02em; cursor:pointer; transition:opacity .15s ease; }\n  .fm-bn:hover:not(:disabled) { opacity:.88; }\n  .fm-bn:disabled { opacity:.5; cursor:not-allowed; }\n</style>\n<script>\n  (function () {\n    function place() {\n      var src = document.querySelector('[data-fm-bn-src]');\n      var atc = document.querySelector('form.st_pi-form [data-st-atc]');\n      if (!src || !atc) return;\n      var btn = src.querySelector('[data-fm-buy-now]');\n      if (!btn || btn.dataset.fmBound) return;\n      btn.dataset.fmBound = '1';\n      atc.insertAdjacentElement('afterend', btn);\n      var section = src.closest('.shopify-section');\n      if (section) section.style.display = 'none';\n      var form = atc.closest('form');\n      function sync() { btn.disabled = atc.disabled || atc.hasAttribute('data-st-disabled'); }\n      if (window.MutationObserver) new MutationObserver(sync).observe(atc, { attributes: true, attributeFilter: ['disabled', 'data-st-disabled'] });\n      btn.addEventListener('click', function () {\n        if (btn.disabled) return;\n        var idInput = form.querySelector('[data-st-variant-id]') || form.querySelector('[name=\"id\"]');\n        var variantId = idInput && idInput.value;\n        if (!variantId) return;\n        var qtyInput = (form.id && document.querySelector('[data-st-qty-input][form=\"' + form.id + '\"]')) || form.querySelector('[data-st-qty-input]');\n        var qty = Math.max(1, parseInt(qtyInput && qtyInput.value, 10) || 1);\n        var label = btn.querySelector('[data-fm-bn-label]');\n        var original = label.textContent;\n        var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';\n        btn.disabled = true;\n        label.textContent = 'Redirection vers le paiement…';\n        fetch(root + 'cart/add.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },\n          body: JSON.stringify({ items: [{ id: Number(variantId), quantity: qty }] })\n        }).then(function (res) {\n          if (!res.ok) return res.json().then(function (e) { throw new Error(e.description || e.message || 'Erreur'); });\n          window.location.href = root + 'checkout';\n        }).catch(function (err) {\n          btn.disabled = false;\n          label.textContent = original;\n          var box = form.querySelector('[data-st-error]');\n          if (box) box.textContent = err.message || 'Impossible d’ajouter ce produit au panier.';\n        });\n      });\n    }\n    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', place); else place();\n    document.addEventListener('shopify:section:load', place);\n  })();\n</script>\n{%- if product.tags contains 'promo-10' -%}\n{%- assign fm_full = product.selected_or_first_available_variant.price -%}\n{%- assign fm_disc = fm_full | times: 0.9 | round -%}\n<script>\n  (function () {\n    var FULL = {{ fm_full | money | strip_html | json }};\n    var DISC = {{ fm_disc | money | strip_html | json }};\n    function apply() {\n      var p = document.querySelector('[data-st-price]');\n      var c = document.querySelector('[data-st-compare]');\n      var b = document.querySelector('[data-st-sale-badge]');\n      var l = document.querySelector('[data-st-atc-label]');\n      if (p && p.textContent.trim() !== DISC) p.textContent = DISC;\n      if (c && (c.textContent.trim() !== FULL || c.style.display === 'none')) { c.textContent = FULL; c.style.display = ''; }\n      if (b && (b.textContent.trim() !== '-10%' || !b.classList.contains('is-visible'))) { b.textContent = '-10%'; b.classList.add('is-visible'); }\n      if (l && l.textContent.indexOf(FULL) !== -1) l.textContent = l.textContent.split(FULL).join(DISC);\n    }\n    function init() {\n      apply();\n      if (!window.MutationObserver) return;\n      var mo = new MutationObserver(apply);\n      var row = document.querySelector('.st_pi-price-row');\n      var l = document.querySelector('[data-st-atc-label]');\n      if (row) mo.observe(row, { childList: true, characterData: true, subtree: true, attributes: true });\n      if (l) mo.observe(l, { childList: true, characterData: true, subtree: true });\n    }\n    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();\n  })();\n</script>\n{%- endif -%}\n",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
