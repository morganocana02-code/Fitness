      "blocks": {
        "review_PKtQBK": {
          "type": "review",
          "settings": {
            "image_demo_url": "",
            "rating": 5,
            "reviewer_name": "Bandaranayak",
            "review_title": "Sûr et fiable",
            "review_text": "Avec mes 125 kg, je suis très impressionné par la capacité maximale de 136 kg ! Le Walking Pad ne bouge pas, même lorsque je marche jusqu’à 8 km/h. Sûr et fiable !"
          }
        },
        "review_Na9XUf": {
          "type": "review",
          "settings": {
            "image_demo_url": "",
            "rating": 5,
            "reviewer_name": "Torsten F.",
            "review_title": "Forte dépense calorique",
            "review_text": "Grâce à l’inclinaison, je peux brûler nettement plus de calories. Génial !"
          }
        },
        "review_yDCUgR": {
          "type": "review",
          "settings": {
            "image_demo_url": "",
            "rating": 5,
            "reviewer_name": "Eduard",
            "review_title": "Très satisfait",
            "review_text": "L’inclinaison rend l’entraînement nettement plus efficace tout en restant agréable pour les articulations. Il est silencieux et facile à ranger, ce qui le rend idéal pour la maison."
          }
        },
        "review_AH4f7n": {
          "type": "review",
          "settings": {
            "image_demo_url": "",
            "rating": 5,
            "reviewer_name": "John",
            "review_title": "Très bon produit",
            "review_text": "Le brassard a été livré rapidement et était bien emballé. Il comprend un velcro supplémentaire pour différents tours de bras.\n\nJe l’ai acheté pour mon Samsung Galaxy S20 FE et j’en suis très satisfait. Les picots antidérapants à l’intérieur assurent une excellente tenue, même lorsqu’on transpire.\n\nL’ouverture du téléphone dispose également d’un velcro qui empêche le smartphone de tomber. Le compartiment pour les clés et autres petits objets est étonnamment spacieux et l’écran tactile reste facilement utilisable."
          }
        },
        "review_dV9ER3": {
          "type": "review",
          "settings": {
            "image_demo_url": "",
            "rating": 5,
            "reviewer_name": "Andreas K.",
            "review_title": "Excellentes conditions de garantie",
            "review_text": "La garantie de 2 ans me rassure. Le service client est également rapide et serviable."
          }
        },
        "review_MHtq64": {
          "type": "review",
          "settings": {
            "image_demo_url": "",
            "rating": 5,
            "reviewer_name": "Roland B.",
            "review_title": "Parfait pour le télétravail",
            "review_text": "Le moteur silencieux est une véritable bénédiction pour le télétravail ! Je peux participer à des appels vidéo sans que mes collègues entendent mes pas. Même à 6 km/h, il est presque inaudible."
          }
        },
        "review_MNJkdw": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/femme-heureuse.png",
            "image_demo_url": "",
            "rating": 5,
            "reviewer_name": "Emma",
            "review_title": "Absolument recommandable !",
            "review_text": "Excellent appareil, rapport qualité-prix irréprochable et très simple à utiliser. Pendant la course, il est possible de régler l’inclinaison, ce qui est très pratique puisqu’il n’est pas nécessaire d’arrêter le tapis pour modifier l’inclinaison."
          }
        },
        "review_39C9mN": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/homme-sportif-premium.png",
            "image_demo_url": "",
            "rating": 4.5,
            "reviewer_name": "Marco",
            "review_title": "Très bon et écran bien visible",
            "review_text": "Pour le moment, il fonctionne très bien et est très facile à monter. Je suis très satisfaite et sa taille est parfaite pour la maison."
          }
        },
        "review_WQ8aMw": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/visage-de-sportive.png",
            "image_demo_url": "",
            "rating": 4.5,
            "reviewer_name": "Lara",
            "review_title": "Design fin et facile à ranger",
            "review_text": "Ce walking pad est vraiment excellent.\nL’inclinaison de 15 % permet un entraînement intense et efficace. La vitesse de 8 à 10 km/h est parfaite pour marcher et faire du jogging. Le moteur de 2,5 CV est puissant et très silencieux.\n\nLe triple système d’amortissement rend la surface douce et confortable. Il réduit le bruit et protège les articulations. Le tapis est stable et sûr pendant l’utilisation.\n\nIl supporte jusqu’à 136 kg sans problème. Son design fin permet de le ranger facilement et de le déplacer dans la maison. Il convient parfaitement à la maison, au bureau ou aux petits espaces.\n\nJ’aime particulièrement pouvoir l’utiliser tout en travaillant à mon bureau. Très bonne qualité et fonctionnement fluide. Je suis très satisfait de ce walking pad."
          }
        },
        "review_aEGE83": {
          "type": "review",
          "settings": {
            "image": "shopify://shop_images/portrait-illustratif-9.png",
            "image_demo_url": "",
            "rating": 5,
            "reviewer_name": "Oliver",
            "review_title": "Excellent appareil",
            "review_text": "Excellent Walking Pad. La qualité est vraiment très bonne et l’appareil donne une impression haut de gamme. Il atteint une vitesse maximale de 10 km/h et dispose d’une inclinaison intégrée, ce qui en fait un appareil d’entraînement parfait.\n\nL’écran permet de voir la vitesse actuelle. Il est également très silencieux, ce qui permet de regarder tranquillement un film pendant l’utilisation."
          }
        }
      },
