{{ 'ww-premium.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ww-premium.js' | asset_url }}" defer="defer"></script>

<section class="ww ww-section{% if section.settings.mist %} ww-section--mist{% endif %}" id="ww-packs" aria-labelledby="ww-packs-{{ section.id }}">
  <div class="ww-container">
    <div class="ww-head">
      {%- if section.settings.eyebrow != blank -%}<p class="ww-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="ww-h2" id="ww-packs-{{ section.id }}">{{ section.settings.title | escape }}</h2>
      {%- if section.settings.text != blank -%}<p class="ww-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    <div class="ww-grid ww-grid--3">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <div class="ww-grid__item" {{ block.shopify_attributes }}>
            {%- render 'ww-pack-card',
              p: p,
              moment: block.settings.moment,
              pitch: block.settings.pitch,
              contents: block.settings.contents,
              badge: block.settings.badge,
              card_image: block.settings.image,
              block: block,
              button_label: section.settings.button_label
            -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="ww-note">{% render 'ww-icon', name: 'shield' %}<span>{{ section.settings.note | escape }}</span></p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* Carte pack : les produits du pack côte à côte, séparés par des « + » */
  /* Sélecteurs renforcés : Shopify charge ce bloc avant ww-premium.css */
  .ww-pack .ww-pack__media.ww-pack__media--items { display: flex; align-items: center; justify-content: center; aspect-ratio: auto; min-height: 0; padding: 40px 12px 14px; }
  .ww-pack__items { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; }
  .ww-pack__item { flex: 1 1 0; min-width: 0; max-width: 68px; aspect-ratio: 1 / 1; padding: 4px; border-radius: 12px; overflow: hidden; background: #ffffff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08); }
  .ww-pack .ww-pack__media--items .ww-pack__item img { width: 100%; height: 100%; object-fit: contain; border-radius: 8px; }
  .ww-pack:hover .ww-pack__media--items .ww-pack__item img { transform: none; }
  .ww-pack__plus { flex: none; font-size: 16px; font-weight: 600; line-height: 1; color: #8a909b; }
  /* Étiquette (par exemple « Le plus complet ») : centrée en haut de la carte */
  .ww-pack .ww-pack__media--items .ww-pack__badge { top: 12px; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--ww-violet); }
  /* Pack mis en avant : contour de couleur */
  .ww-pack.ww-pack--featured, .ww-section--mist .ww-pack.ww-pack--featured { border: 2px solid var(--ww-violet); }
{% endstylesheet %}

{% schema %}
{
  "name": "WW · Packs",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Les packs" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Choisissez votre pack." },
    { "type": "text", "id": "text", "label": "Texte", "default": "Le même tapis de course pliable dans chaque pack. Choisissez ce qui l'accompagne selon votre façon de bouger." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Ajouter au panier" },
    { "type": "text", "id": "note", "label": "Phrase sous les packs", "default": "Pour les trois packs : livraison offerte en 5 à 7 jours ouvrés, 14 jours pour changer d'avis et garantie légale de 2 ans." },
    { "type": "checkbox", "id": "mist", "label": "Fond gris clair", "default": false }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "text", "id": "moment", "label": "Moment", "default": "Le soir" },
        { "type": "text", "id": "pitch", "label": "Phrase d'accroche" },
        { "type": "richtext", "id": "contents", "label": "Contenu du pack" },
        { "type": "text", "id": "badge", "label": "Étiquette sur l'image (facultative)" },
        { "type": "image_picker", "id": "image", "label": "Photo de la carte (facultative)", "info": "Remplace la photo principale du produit sur cette carte uniquement." },
        { "type": "header", "content": "Produits du pack" },
        { "type": "paragraph", "content": "À partir de 2 photos, la carte montre les produits côte à côte, séparés par des « + », à la place de la photo principale." },
        { "type": "image_picker", "id": "item_image_1", "label": "Produit 1" },
        { "type": "image_picker", "id": "item_image_2", "label": "Produit 2" },
        { "type": "image_picker", "id": "item_image_3", "label": "Produit 3" },
        { "type": "image_picker", "id": "item_image_4", "label": "Produit 4" }
      ]
    }
  ],
  "presets": [
    {
      "name": "WW · Packs",
      "blocks": [
        { "type": "pack" },
        { "type": "pack" },
        { "type": "pack" }
      ]
    }
  ]
}
{% endschema %}
