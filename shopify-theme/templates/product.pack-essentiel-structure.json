    "faq_and_text": {
      "type": "st_faq-and-text",
      "blocks": {
        "faq_item_1_faq_and_text": {
          "type": "faq_item",
          "settings": {
            "question": "Que contient exactement le pack ?",
            "answer": "<p>Le pack réunit un tapis de marche pliable, un tapis Fitness Pro anti-bruit de 200 × 90 cm, un kit de bandes élastiques à 4 niveaux de résistance et une gourde.</p>"
          }
        },
        "faq_item_2_faq_and_text": {
          "type": "faq_item",
          "settings": {
            "question": "Le tapis de marche prend-il de la place ?",
            "answer": "<p>Non. Son format fin se range à plat sous un lit, un canapé ou un bureau. Il va de 1 à 10 km/h, monte jusqu’à 15 % d’inclinaison et supporte jusqu’à 136 kg.</p>"
          }
        },
        "faq_item_3_faq_and_text": {
          "type": "faq_item",
          "settings": {
            "question": "À quoi servent les bandes élastiques ?",
            "answer": "<p>Les bandes élastiques, avec 4 niveaux de résistance, complètent vos séances par des exercices au sol, sans changer de pièce.</p>"
          }
        },
        "faq_item_4_faq_and_text": {
          "type": "faq_item",
          "settings": {
            "question": "Quelles sont les garanties ?",
            "answer": "<p>Vous bénéficiez de la livraison gratuite, de 14 jours pour changer d’avis et d’une garantie de 2 ans sur le tapis de marche.</p>"
          }
        }
      },
      "block_order": [
        "faq_item_1_faq_and_text",
        "faq_item_2_faq_and_text",
        "faq_item_3_faq_and_text",
        "faq_item_4_faq_and_text"
      ],
