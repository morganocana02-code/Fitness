    "faq_and_text": {
      "type": "st_faq-and-text",
      "blocks": {
        "faq_item_1_faq_and_text": {
          "type": "faq_item",
          "settings": {
            "question": "Que contient exactement le pack ?",
            "answer": "<p>Le pack comprend un tapis de marche pliable, une montre connectée, un tapis Fitness Pro anti-bruit, un lot d’haltères, une barre de musculation, une gourde Tritan, un brassard sport et une ceinture de sudation.</p>"
          }
        },
        "faq_item_2_faq_and_text": {
          "type": "faq_item",
          "settings": {
            "question": "Le tapis est-il facile à ranger ?",
            "answer": "<p>Oui, le tapis de marche est pliable : une fois la séance terminée, il se range facilement dans un coin de pièce.</p>"
          }
        },
        "faq_item_3_faq_and_text": {
          "type": "faq_item",
          "settings": {
            "question": "Le bruit gêne-t-il les voisins ?",
            "answer": "<p>Le tapis Fitness Pro anti-bruit protège votre sol et limite les bruits d’impact pour préserver la tranquillité du foyer.</p>"
          }
        },
        "faq_item_4_faq_and_text": {
          "type": "faq_item",
          "settings": {
            "question": "Comment fonctionne la garantie ?",
            "answer": "<p>Vous bénéficiez de la livraison gratuite, de 14 jours pour changer d’avis et d’une garantie de 2 ans sur le tapis de marche.</p>"
          }
        }
      },
