              "blocks": {
                "row2_text": {
                  "type": "text",
                  "settings": {
                    "text": "<p><strong>Essentiel Appartement :</strong> tapis de marche pliable, kit de bandes élastiques 4 niveaux, tapis Fitness Pro anti-bruit 200 × 90 cm et gourde.<br/><strong>Télétravail Connecté :</strong> tapis de marche pliable, montre connectée, brassard sport universel et ceinture de sudation.<br/><strong>Ultimate Home Gym :</strong> tapis de marche pliable, montre connectée, tapis Fitness Pro anti-bruit, lot d’haltères, barre de musculation, gourde Tritan, brassard sport et ceinture de sudation.</p>",
                    "width": "100%",
